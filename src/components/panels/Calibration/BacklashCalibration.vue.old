<template>
    <v-container fluid class="backlash-calibration">
        <v-card elevation="2" class="mx-auto" max-width="1200">
            <v-card-title class="primary white--text">
                <v-icon left color="white">mdi-cog</v-icon>
                Calibração de Backlash
            </v-card-title>
            
            <v-card-text class="pa-6">
                <!-- Seleção do tipo de impressora -->
                <v-row class="mb-6">
                    <v-col cols="12" md="6">
                        <v-select
                            v-model="selectedPrinterType"
                            :items="printerOptions"
                            item-text="text"
                            item-value="value"
                            label="Selecione o Tipo da Impressora"
                            outlined
                            prepend-icon="mdi-printer-3d"
                            @change="loadDefaultSettings"
                        ></v-select>
                    </v-col>
                    <v-col cols="12" md="6">
                        <v-alert 
                            dense 
                            text 
                            :type="statusType"
                            v-if="statusMessage"
                            class="ma-0"
                        >
                            {{ statusMessage }}
                        </v-alert>
                    </v-col>
                </v-row>

                <!-- Configurações X1 -->
                <v-expand-transition>
                    <backlash-settings-x1 
                        v-if="selectedPrinterType === 'X1'"
                        :backlash-x="backlashX"
                        :backlash-y="backlashY"
                        @update:backlash-x="backlashX = $event"
                        @update:backlash-y="backlashY = $event"
                        @settings-changed="onSettingsChanged"
                    ></backlash-settings-x1>
                </v-expand-transition>

                <!-- Configurações IDEX -->
                <v-expand-transition>
                    <backlash-settings-idex 
                        v-if="selectedPrinterType === 'IDEX'"
                        :extruder0="extruder0Settings"
                        :extruder1="extruder1Settings"
                        @update:extruder0="extruder0Settings = $event"
                        @update:extruder1="extruder1Settings = $event"
                        @settings-changed="onSettingsChanged"
                    ></backlash-settings-idex>
                </v-expand-transition>

                <!-- Ações de Calibração -->
                <v-row class="mt-6" v-if="selectedPrinterType">
                    <v-col cols="12" lg="8">
                        <calibration-actions
                            :printer-type="selectedPrinterType"
                            :can-print="canPrint"
                            @print-x="printCalibrationX"
                            @print-y="printCalibrationY"
                        ></calibration-actions>
                    </v-col>
                    
                    <v-col cols="12" lg="4">
                        <calibration-controls
                            @reset-params="confirmResetParameters"
                            @restart-service="confirmRestartService"
                        ></calibration-controls>
                    </v-col>
                </v-row>
            </v-card-text>
        </v-card>

        <!-- Dialog de Confirmação -->
        <confirmation-dialog
            v-model="confirmDialog.show"
            :title="confirmDialog.title"
            :message="confirmDialog.message"
            @confirm="executeConfirmAction"
        ></confirmation-dialog>

        <!-- Snackbar de Notificações -->
        <notification-snackbar
            v-model="notification.show"
            :message="notification.message"
            :color="notification.color"
        ></notification-snackbar>
    </v-container>
</template>

<script>
// Importações dos sub-componentes
import BacklashSettingsX1 from './BacklashSettingsX1.vue'
import BacklashSettingsIdex from './BacklashSettingsIdex.vue'
import CalibrationActions from './CalibrationActions.vue'
import CalibrationControls from './CalibrationControls.vue'
import ConfirmationDialog from './ConfirmationDialog.vue'
import NotificationSnackbar from './NotificationSnackbar.vue'

export default {
    name: 'BacklashCalibration',
    components: {
        BacklashSettingsX1,
        BacklashSettingsIdex,
        CalibrationActions,
        CalibrationControls,
        ConfirmationDialog,
        NotificationSnackbar
    },
    
    data() {
        return {
            selectedPrinterType: '',
            
            // Opções de impressora
            printerOptions: [
                { text: 'X1 Standard', value: 'X1' },
                { text: 'IDEX Dual Extruder', value: 'IDEX' }
            ],
            
            // Configurações X1
            backlashX: 0.0,
            backlashY: 0.0,
            
            // Configurações IDEX
            extruder0Settings: {
                x: 0.0,
                y: 0.0
            },
            extruder1Settings: {
                x: 0.0,
                y: 0.0
            },
            
            // Status
            statusMessage: '',
            statusType: 'info',
            settingsChanged: false,
            
            // Dialog de confirmação
            confirmDialog: {
                show: false,
                title: '',
                message: '',
                action: null
            },
            
            // Notificações
            notification: {
                show: false,
                message: '',
                color: 'success'
            },
            
            // Estados de operação
            operationInProgress: false,
            
            // Configurações padrão vindas de JSON
            defaultSettings: {
                X1: { x: 0.1, y: 0.1 },
                IDEX: {
                    extruder0: { x: 0.15, y: 0.12 },
                    extruder1: { x: 0.18, y: 0.14 }
                }
            }
        }
    },
    
    computed: {
        canPrint() {
            return this.selectedPrinterType !== '' && !this.operationInProgress
        }
    },
    
    async mounted() {
        await this.loadConfigurationsFromJson()
        this.setInitialStatus()
    },
    
    methods: {
        async loadConfigurationsFromJson() {
            try {
                // Aqui você carregaria de um arquivo JSON real
                // const response = await fetch('/api/backlash-config.json')
                // const config = await response.json()
                
                // Por enquanto usando configuração estática
                console.log('Configurações carregadas do JSON')
                
                if (this.printerOptions.length > 0) {
                    this.selectedPrinterType = this.printerOptions[0].value
                    this.loadDefaultSettings()
                }
            } catch (error) {
                console.error('Erro ao carregar configurações:', error)
                this.showNotification('Erro ao carregar configurações', 'error')
            }
        },
        
        loadDefaultSettings() {
            if (!this.selectedPrinterType) return
            
            const defaults = this.defaultSettings[this.selectedPrinterType]
            
            if (this.selectedPrinterType === 'X1') {
                this.backlashX = defaults.x
                this.backlashY = defaults.y
            } else if (this.selectedPrinterType === 'IDEX') {
                this.extruder0Settings = { ...defaults.extruder0 }
                this.extruder1Settings = { ...defaults.extruder1 }
            }
            
            this.statusMessage = `Configuração padrão carregada para ${this.selectedPrinterType}`
            this.statusType = 'success'
            this.settingsChanged = false
        },
        
        onSettingsChanged() {
            this.statusMessage = 'Configurações alteradas - Lembre-se de aplicar as mudanças'
            this.statusType = 'warning'
            this.settingsChanged = true
        },
        
        async printCalibrationX() {
            this.operationInProgress = true
            try {
                await this.applyCurrentSettings()
                await this.sendCommand('PRINT_CALIBRATION_X')
                this.showNotification('Impressão de calibração X iniciada', 'success')
            } catch (error) {
                this.showNotification('Erro ao iniciar impressão X', 'error')
            } finally {
                this.operationInProgress = false
            }
        },
        
        async printCalibrationY() {
            this.operationInProgress = true
            try {
                await this.applyCurrentSettings()
                await this.sendCommand('PRINT_CALIBRATION_Y')
                this.showNotification('Impressão de calibração Y iniciada', 'success')
            } catch (error) {
                this.showNotification('Erro ao iniciar impressão Y', 'error')
            } finally {
                this.operationInProgress = false
            }
        },
        
        confirmResetParameters() {
            this.confirmDialog = {
                show: true,
                title: 'Resetar Parâmetros',
                message: 'Tem certeza que deseja resetar todos os parâmetros para os valores padrão? Esta ação não pode ser desfeita.',
                action: this.resetParameters
            }
        },
        
        confirmRestartService() {
            this.confirmDialog = {
                show: true,
                title: 'Reiniciar Serviço',
                message: 'Tem certeza que deseja reiniciar o serviço? Isso pode interromper operações em andamento.',
                action: this.restartService
            }
        },
        
        async executeConfirmAction() {
            if (this.confirmDialog.action) {
                await this.confirmDialog.action()
            }
        },
        
        async resetParameters() {
            this.operationInProgress = true
            try {
                this.loadDefaultSettings()
                await this.applyCurrentSettings()
                this.showNotification('Parâmetros resetados com sucesso', 'success')
                this.statusMessage = 'Parâmetros resetados para valores padrão'
                this.statusType = 'success'
            } catch (error) {
                this.showNotification('Erro ao resetar parâmetros', 'error')
            } finally {
                this.operationInProgress = false
            }
        },
        
        async restartService() {
            this.operationInProgress = true
            try {
                await this.sendCommand('FIRMWARE_RESTART')
                this.showNotification('Serviço reiniciado com sucesso', 'success')
            } catch (error) {
                this.showNotification('Erro ao reiniciar serviço', 'error')
            } finally {
                this.operationInProgress = false
            }
        },
        
        async applyCurrentSettings() {
            const commands = []
            
            if (this.selectedPrinterType === 'X1') {
                commands.push(`SET_BACKLASH_COMPENSATION AXIS=X DISTANCE=${this.backlashX}`)
                commands.push(`SET_BACKLASH_COMPENSATION AXIS=Y DISTANCE=${this.backlashY}`)
            } else if (this.selectedPrinterType === 'IDEX') {
                commands.push(`SET_BACKLASH_COMPENSATION EXTRUDER=0 AXIS=X DISTANCE=${this.extruder0Settings.x}`)
                commands.push(`SET_BACKLASH_COMPENSATION EXTRUDER=0 AXIS=Y DISTANCE=${this.extruder0Settings.y}`)
                commands.push(`SET_BACKLASH_COMPENSATION EXTRUDER=1 AXIS=X DISTANCE=${this.extruder1Settings.x}`)
                commands.push(`SET_BACKLASH_COMPENSATION EXTRUDER=1 AXIS=Y DISTANCE=${this.extruder1Settings.y}`)
            }
            
            for (const command of commands) {
                await this.sendCommand(command)
            }
            
            this.settingsChanged = false
        },
        
        async sendCommand(command) {
            console.log(`Enviando comando: ${command}`)
            
            // Implementação real do envio de comando
            // Substituir por sua implementação de socket/API
            return new Promise((resolve, reject) => {
                setTimeout(() => {
                    if (Math.random() > 0.1) {
                        resolve()
                    } else {
                        reject(new Error('Falha na comunicação'))
                    }
                }, 1000)
            })
        },
        
        showNotification(message, color = 'success') {
            this.notification = {
                show: true,
                message,
                color
            }
        },
        
        setInitialStatus() {
            this.statusMessage = 'Selecione o tipo de impressora para começar'
            this.statusType = 'info'
        }
    }
}
</script>

<style scoped>
.backlash-calibration {
    min-height: 100vh;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    padding: 20px;
}

.v-card {
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

.v-card-title {
    border-radius: 12px 12px 0 0;
}

/* Garante que nenhum outro componente aparece */
.backlash-calibration >>> *:not(.backlash-calibration *) {
    display: none !important;
}
</style>